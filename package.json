{
  "name": "threefold-tictactoe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Three marks. Endless possibilities. A vanishing tic-tac-toe game.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew --no-daemon :app:assembleDebug :app:assembleDebugAndroidTest :app:bundleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  }
}
